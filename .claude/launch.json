{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "intake-server",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "scripts/intake_server.py"
      ],
      "port": 8765
    },
    {
      "name": "facade-atlas",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "scripts/atlas_server.py",
        "--port",
        "8770"
      ],
      "port": 8770
    },
    {
      "name": "vcmap-test",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "viewers/vcmap/dist"
      ],
      "port": 8790
    }
  ]
}
